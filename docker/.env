# ==============================
# 🧠 模型路径（相对于项目根目录）
# ==============================
MODEL_DIR=pretrained_models/CosyVoice-300M-SFT

# ==============================
# ⚙️ 推理后端（CPU 安全配置）
# ==============================
LOAD_JIT=True
LOAD_TRT=False
FP16=False
LOAD_VLLM=False
NO_AUTO_VLLM=True

# ==============================
# 🌐 端口
# ==============================
API_PORT=9996
WEBUI_PORT=8000

# ==============================
# 📁 宿主机路径（相对于项目根目录）
# 注意：docker-compose.yml 在 docker/ 目录下，
# 所以这些路径是从 docker/ 的父目录（即项目根）计算的
# ==============================
MODELS_PATH=../pretrained_models
LOGS_PATH=../logs
TMP_PATH=../tmp
CONFIG_PATH=../config
CACHE_PATH=../.cache

# ==============================
# 🧵 CPU 性能调优（可选）
# ==============================
# OMP_NUM_THREADS=4  # 可在 Dockerfile 或启动命令中设置
# TZ=Asia/Shanghai