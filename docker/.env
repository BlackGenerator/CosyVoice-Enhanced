# CosyVoice API Docker Environment Configuration
# Copy this file to .env and modify the values as needed

# ==============================================
# API Server Configuration
# ==============================================
# Server host (0.0.0.0 for Docker)
# Server port
API_PORT=9996

# ==============================================
# Model Configuration  
# ==============================================
# Path to the model directory inside container
# Available models: CosyVoice2-0.5B, CosyVoice-300M, CosyVoice-300M-SFT, CosyVoice-300M-Instruct
MODEL_DIR=pretrained_models/CosyVoice-300M-SFT

# ==============================================
# Host Path Configuration (IMPORTANT!)
# ==============================================
# Path to your pretrained models on the host machine
# This should be the directory containing your downloaded models
MODELS_PATH=../pretrained_models

# Path for logs on host machine
LOGS_PATH=../logs

# Path for temporary files on host machine  
TMP_PATH=../tmp

# Optional: Path for configuration files on host machine
CONFIG_PATH=../config

# ==============================================
# Performance Optimization
# ==============================================
# Enable JIT compilation (can improve performance but increases startup time)
LOAD_JIT=true

# Enable TensorRT optimization (Linux only, requires TensorRT installation)
LOAD_TRT=false

# Enable FP16 precision (can improve performance and reduce memory usage)
FP16=true

# ==============================================
# VLLM Configuration (CosyVoice2 only)
# ==============================================
# VLLM mode: auto (auto-detect), true (force enable), false (force disable)
LOAD_VLLM=auto

# Disable automatic VLLM detection (set to true to force disable VLLM)
NO_AUTO_VLLM=false

# ==============================================
# Example Configurations
# ==============================================

# High Performance Configuration (if you have powerful GPU):
# LOAD_JIT=true
# FP16=true
# USE_FLOW_CACHE=true
# LOAD_VLLM=true

# Memory Optimized Configuration:
# FP16=true
# LOAD_VLLM=false

# CPU Only Configuration (not recommended for production):
# CUDA_VISIBLE_DEVICES=""
# LOAD_VLLM=false
# LOAD_TRT=false